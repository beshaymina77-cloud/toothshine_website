{
  // Cloudflare Worker that serves the built static site (dist/).
  "name": "toothshine-dental",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "toothshinecenter.com", "custom_domain": true },
    { "pattern": "www.toothshinecenter.com", "custom_domain": true }
  ]
}
